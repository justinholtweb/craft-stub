{
    "name": "justinholtweb/craft-stub",
    "description": "Booking & appointments plugin for Craft CMS",
    "type": "craft-plugin",
    "version": "5.1.1",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.5",
        "stripe/stripe-php": "^13.0 || ^14.0 || ^15.0 || ^16.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "craftcms/rector": "dev-main",
        "pestphp/pest": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\stub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\stub\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "test-unit": "pest --group=unit",
        "phpstan": "phpstan analyse",
        "ecs": "ecs check --ansi",
        "ecs-fix": "ecs check --fix --ansi"
    },
    "extra": {
        "handle": "stub",
        "name": "Stub",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-stub/blob/main/README.md",
        "class": "justinholtweb\\stub\\Plugin"
    }
}
